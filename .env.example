# Copy to .env and adjust. Every value here has a working default; nothing in
# this file is required to start the service.

# --- app -----------------------------------------------------------------
KYC_APP_NAME=KYC API
KYC_DEBUG=false
KYC_MODELS_DIR=./models
# Empty means same-origin only. Set real origins in production - never "*"
# on a service that receives identity documents.
KYC_CORS_ORIGINS=["https://your-frontend.example"]
KYC_MAX_UPLOAD_BYTES=12582912

# --- inference -----------------------------------------------------------
# Inference is CPU-only by design. Add "CUDAExecutionProvider" first only if
# the deployment actually has a GPU.
KYC_ONNX_PROVIDERS=["CPUExecutionProvider"]
KYC_ONNX_INTRA_THREADS=0

# --- ocr: input gating ---------------------------------------------------
KYC_OCR_MIN_IMAGE_SIDE=400
KYC_OCR_MAX_IMAGE_SIDE=2400
# Laplacian variance on the whole frame (rectify=false). Real, legible photos
# measured 17-52, so 60 rejected them; 12 still catches an out-of-focus frame.
KYC_OCR_MIN_SHARPNESS=12
KYC_OCR_MIN_BRIGHTNESS=45
KYC_OCR_MAX_BRIGHTNESS=215
KYC_OCR_MAX_GLARE_RATIO=0.06

# --- ocr: geometry -------------------------------------------------------
# Must match how the field detector was trained. The shipped detector was
# trained on unrectified photos (see models/manifest.yaml), so keep this off.
KYC_OCR_RECTIFY=false

# --- ocr: field detector -------------------------------------------------
KYC_OCR_DETECTOR_CONF=0.35
KYC_OCR_DETECTOR_IOU=0.45
KYC_OCR_FIELD_CROP_PADDING=0.06

# --- ocr: recognition ----------------------------------------------------
# Chosen by held-out measurement (models/manifest.yaml):
#   names:  easyocr 57.1% vs crnn_onnx 38.8% exact-match -> easyocr
#   digits: crnn_onnx_digits 68.4% vs easyocr 7.0%       -> crnn_onnx_digits
# crnn_onnx_digits needs models/crnn_fa_digits.onnx + .charset.txt.
KYC_OCR_TEXT_BACKEND=easyocr
KYC_OCR_DIGIT_BACKEND=crnn_onnx_digits
KYC_OCR_MIN_FIELD_CONFIDENCE=0.40
KYC_OCR_REVIEW_ON_LOW_CONFIDENCE=true

# --- face capture (selfie) ----------------------------------------------
# First guesses from ~15 still photos; recalibrate on real webcam frames.
KYC_FACE_QUALITY_DETECTOR_MODEL=buffalo_l_det_10g.onnx
KYC_FACE_QUALITY_LANDMARK_MODEL=buffalo_l_2d106det.onnx
KYC_FACE_QUALITY_MIN_FACE_HEIGHT_RATIO=0.20
KYC_FACE_QUALITY_MAX_FACE_HEIGHT_RATIO=0.65
KYC_FACE_QUALITY_MIN_SHARPNESS=12
KYC_FACE_QUALITY_MAX_YAW_DEG=20
KYC_FACE_QUALITY_MAX_PITCH_DEG=25
KYC_FACE_QUALITY_MAX_ROLL_DEG=15
KYC_FACE_QUALITY_MIN_EYE_OPENNESS=0.15
KYC_FACE_QUALITY_MAX_MOUTH_OPENNESS=0.15
KYC_FACE_QUALITY_MAX_GAZE_OFFSET=0.12
# Vertical gaze window; above the max = looking down. Interim, from one real frame.
KYC_FACE_QUALITY_MIN_GAZE_VERTICAL=-0.55
KYC_FACE_QUALITY_MAX_GAZE_VERTICAL=-0.17
# Occlusion logit floor. The prototype's 0.25 flagged headscarves and beards
# as covered; -3.0 let a hand over the mouth through. -2.0 is an interim
# compromise until the model is retrained (see models/manifest.yaml).
KYC_FACE_QUALITY_OCCLUSION_MODEL=face_occlusion_mnv3.onnx
KYC_FACE_QUALITY_MIN_CLEAR_LOGIT=-2.0
# off | info | warn | error. error = the user must stand in front of a plain wall.
KYC_FACE_QUALITY_BACKGROUND_CHECK=error
KYC_FACE_QUALITY_MAX_BACKGROUND_EDGE_DENSITY=0.03
# Webcams blur the background; its luma spread catches what edges miss.
KYC_FACE_QUALITY_MAX_BACKGROUND_LUMA_STD=30
# Hint shown only once a problem is seen in 2 of the last 3 frames.
KYC_FACE_QUALITY_HINT_WINDOW=3
KYC_FACE_QUALITY_HINT_MIN_COUNT=2
# 0 = off until the anti-spoof module measures how much context it needs.
KYC_FACE_QUALITY_MIN_CONTEXT_SCALE=0
KYC_FACE_QUALITY_FRAMES_REQUIRED_OK=2
# Video first, then a full-resolution still from the same camera; the still
# must show the same person as the video (ArcFace cosine).
KYC_FACE_QUALITY_REQUIRE_STILL=true
KYC_FACE_QUALITY_EMBEDDING_MODEL=buffalo_l_w600k_r50.onnx
KYC_FACE_QUALITY_MIN_STILL_SIMILARITY=0.5
KYC_FACE_QUALITY_SESSION_TTL_S=120

# --- face match (card portrait vs captured selfie) -------------------------
# Cosine similarity of buffalo_l ArcFace embeddings. Proposed from a small set
# of repo pairs (see specs/03-face-match.md §12); card-vs-selfie scores much
# lower than selfie-vs-selfie, so do not reuse selfie thresholds here.
KYC_FACE_MATCH_ACCEPT_ABOVE=0.40
KYC_FACE_MATCH_REJECT_BELOW=0.25
KYC_FACE_MATCH_MIN_REFERENCE_FACE_PX=40
KYC_FACE_MATCH_ROTATION_FALLBACK=true
